# Port the app is served on (default: 3000)
PORT=3000

# ── Laravel ────────────────────────────────────────────────────────────────────
# Generated by make setup
APP_KEY=

# ── Admin token ────────────────────────────────────────────────────────────────
# Both generated by make setup.
#
# STAKE_ADMIN_TOKEN    — SHA-256 hash, passed to the running container
# STAKE_ADMIN_RAW_TOKEN — raw token, kept local only (used by make capture)
#                         never passed to the container
STAKE_ADMIN_TOKEN=
STAKE_ADMIN_RAW_TOKEN=

# ── Stake API ──────────────────────────────────────────────────────────────────
STAKE_API_URL=https://stake.games/_api/graphql
# STAKE_ACCESS_TOKEN=   # only needed if stake.games requires an x-access-token header

# ── Mail ───────────────────────────────────────────────────────────────────────
# Mailpit catches all outgoing email locally — no real mail config needed.
STAKE_CLEARANCE_ALERT_EMAIL=dev@localhost
